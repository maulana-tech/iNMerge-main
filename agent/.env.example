# ── NVIDIA NIM ────────────────────────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx
# Optional — defaults to meta/llama-3.3-70b-instruct
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ── GitHub Bot Account ────────────────────────────────────────────────────────
# Create a dedicated GitHub account for the agent (not your personal account)
# Token needs: repo, pull_requests, fork scopes
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ── Wallet ────────────────────────────────────────────────────────────────────
# Dedicated wallet for the agent — needs MNT (gas) + mUSD (not required for claiming)
# WORKER_ADDRESS is auto-derived from WORKER_PRIVATE_KEY — do NOT set it manually
WORKER_PRIVATE_KEY=0xdeadbeef...

# ── Contract Addresses (Mantle Sepolia) ───────────────────────────────────────
# These are already deployed — do not change unless you redeploy
ISSUE_ADDRESS=0x836112Af92dCA17D5a45d3b4Fc7E490eC6b4B36e
MANTLEUSD_ADDRESS=0x5ab8ddE10e31d503C5db1D734ca64dD2e0066d72

# ── RPC ───────────────────────────────────────────────────────────────────────
# Optional — defaults to public Mantle Sepolia RPC
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz

# ── Behavior ──────────────────────────────────────────────────────────────────
# Poll interval in milliseconds (default: 30 seconds)
POLL_INTERVAL_MS=30000
